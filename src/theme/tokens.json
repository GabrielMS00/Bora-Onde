    "superficie-alt": "#EFECE6",
    "linha": "#E4E0D8",
    "linha-controle": "#8A867F",
    "texto": "#141B24",
    "texto-secundario": "#6E7178",
    "acento": "#141B24",
    "acento-pressionado": "#2A3340",
    "acento-suave": "#E4E1DA",
    "sucesso": "#2E7064",
    "sucesso-suave": "#E3F0EC",
    "alerta": "#8F5F12",
