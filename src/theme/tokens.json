  "layout": {
    "margem": 20,
    "paddingCard": 16,
    "gapCards": 24
  },
  "fontFamilies": {
    "jakarta-bold": "PlusJakartaSans_700Bold",
    "jakarta-extrabold": "PlusJakartaSans_800ExtraBold",
    "dm-regular": "DMSans_400Regular",
    "dm-medium": "DMSans_500Medium",
    "dm-semibold": "DMSans_600SemiBold"
  },
  "type": {
    "display": { "family": "jakarta-extrabold", "size": 32, "lineHeight": 38, "trackingPct": -2 },
    "h1": { "family": "jakarta-bold", "size": 28, "lineHeight": 34, "trackingPct": -2 },
    "h2": { "family": "jakarta-bold", "size": 20, "lineHeight": 26, "trackingPct": -1 },
    "h3": { "family": "jakarta-bold", "size": 16, "lineHeight": 22, "trackingPct": -0.5 },
    "corpo": { "family": "dm-regular", "size": 16, "lineHeight": 24, "trackingPct": 0 },
    "corpo-sm": { "family": "dm-regular", "size": 14, "lineHeight": 20, "trackingPct": 0 },
    "botao": { "family": "dm-semibold", "size": 16, "lineHeight": 20, "trackingPct": 0.5 },
    "rotulo": { "family": "dm-medium", "size": 14, "lineHeight": 20, "trackingPct": 1 },
    "rotulo-forte": { "family": "dm-semibold", "size": 14, "lineHeight": 20, "trackingPct": 1 },
    "tag": { "family": "dm-medium", "size": 13, "lineHeight": 16, "trackingPct": 1 },
    "legenda": { "family": "dm-regular", "size": 12, "lineHeight": 16, "trackingPct": 1 },
    "aba": { "family": "dm-semibold", "size": 11, "lineHeight": 14, "trackingPct": 2 }
  },
  "shadows": {
    "sombra-1": "0 1px 2px 0 #141B240A",
    "sombra-2": "0 8px 24px -12px #141B2433, 0 2px 6px 0 #141B240D",
    "anel-foco": "0 0 0 2px #F7F6F2, 0 0 0 4px #141B24"
  }
