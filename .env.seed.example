# Copie para .env.seed (não versionado). Usado SÓ por scripts/seed.mjs e scripts/check-rls.mjs, na sua máquina.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Secret key (sb_secret_…) ou a service_role legada. Ignora o RLS: NUNCA no app, no chat ou no Git.
SUPABASE_SECRET_KEY=
# Só para scripts/check-rls.mjs (a mesma chave pública do .env).
SUPABASE_PUBLISHABLE_KEY=
