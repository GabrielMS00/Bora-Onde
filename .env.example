# Copie para .env (não versionado) e preencha com os dados do seu projeto Supabase:
# Dashboard → Connect (ou Settings → API Keys).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_…) ou a anon key legada (eyJ…). É pública: o acesso é protegido por RLS.
EXPO_PUBLIC_SUPABASE_KEY=
